{
  "defaultBranch": "main",
  "projectType": "scrypted-plugin",
  "docs": {
    "agentNotes": "AGENTS.md",
    "overview": "README.md",
    "changelog": "CHANGELOG.md",
    "security": "SECURITY.md",
    "contributing": "CONTRIBUTING.md"
  },
  "qualityGate": {
    "setup": {
      "node": "npm ci"
    },
    "tests": {
      "python": "npm test"
    },
    "build": {
      "plugin": "npm run build",
      "npmPackage": "npm pack --dry-run"
    },
    "inspection": {
      "tool": "jetbrains",
      "ide": "PyCharm",
      "scopePreference": ["changed_files", "directory", "whole_project"]
    },
    "docsRequiredWhen": [
      "user-visible settings or behavior change",
      "panel protocol or controller dependency changes",
      "pairing or identity handling changes",
      "packaging or installation changes",
      "validation gate changes"
    ]
  },
  "importantWorkflows": ["Validation"],
  "githubSettings": {
    "expected": {
      "hasIssues": true,
      "hasProjects": false,
      "hasWiki": false,
      "allowMergeCommit": true,
      "allowSquashMerge": false,
      "allowRebaseMerge": false,
      "deleteBranchOnMerge": true,
      "actionsDefaultWorkflowPermissions": "read",
      "actionsCanCreatePullRequests": false,
      "actionsRequireShaPinning": true
    }
  },
  "pullRequests": {
    "preferredMergeMethod": "merge",
    "allowedMergeMethods": ["merge"]
  },
  "branchProtection": {
    "main": {
      "requiresPullRequest": true,
      "requiredStatusChecks": ["validation"],
      "requiresStrictStatusChecks": true,
      "requiredApprovals": 0,
      "blocksForcePushes": true,
      "blocksDeletion": true
    }
  },
  "release": {
    "npmPackage": "@cbusillo/scrypted-qolsys",
    "publish": "manual; owner approves each release before npm publish"
  },
  "cleanup": {
    "deleteMergedLocalBranches": true,
    "removeMergedCleanWorktrees": true
  },
  "metadataFreshness": {
    "updateWhen": [
      "validation gates change",
      "important workflows change",
      "branch protection changes",
      "merge settings change",
      "release process changes",
      "repository visibility changes"
    ]
  }
}
